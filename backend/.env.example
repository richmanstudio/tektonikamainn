APP_NAME=Tektonika CMS API
APP_ENV=development

# Generate a 64+ character random secret. Example command:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=replace_with_a_unique_random_secret_of_at_least_32_characters

ADMIN_USERNAME=tektonikadmin
# Generate with:
# python -c "from app.security import hash_password; import getpass; print(hash_password(getpass.getpass('Admin password: ')))"
ADMIN_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash

TOKEN_TTL_SECONDS=14400
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tektonika_cms
MYSQL_USER=u3171937_default
MYSQL_PASSWORD=put_mysql_password_here

# Production: HTTPS origins only, comma-separated.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
